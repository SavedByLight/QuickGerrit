// Merge into composeApp/build.gradle.kts

import java.util.Properties

val versionNameProp = (findProperty("versionName") as String?)
    ?.removePrefix("v")
    ?.substringBefore("-")
    ?: (rootProject.findProperty("VERSION_NAME") as String?)
    ?: "1.0.0"

val versionCodeProp = (findProperty("versionCode") as String?)?.toIntOrNull()
    ?: versionNameProp.substringAfterLast('.').filter { it.isDigit() }.toIntOrNull()
    ?: 1

val githubRepoProp = (findProperty("githubRepo") as String?)
    ?: System.getenv("GITHUB_REPOSITORY")
    ?: ""

// Generate desktop version constants before compile
val generateDesktopVersion by tasks.registering {
    val outFile = layout.projectDirectory.file(
        "src/desktopMain/kotlin/com/quickgerrit/app/platform/GeneratedVersion.kt"
    ).asFile
    inputs.property("versionName", versionNameProp)
    inputs.property("versionCode", versionCodeProp)
    inputs.property("githubRepo", githubRepoProp)
    outputs.file(outFile)
    doLast {
        outFile.parentFile.mkdirs()
        outFile.writeText(
            """
            package com.quickgerrit.app.platform

            /**
             * AUTO-GENERATED by Gradle — do not edit.
             * versionName=$versionNameProp versionCode=$versionCodeProp
             */
            object GeneratedVersion {
                const val VERSION_NAME: String = "$versionNameProp"
                const val VERSION_CODE: Int = $versionCodeProp
                const val GITHUB_REPO: String = "$githubRepoProp"
            }
            """.trimIndent() + "\n"
        )
        println("GeneratedVersion: $versionNameProp ($versionCodeProp) repo=$githubRepoProp")
    }
}

tasks.matching { it.name.contains("compileKotlinDesktop") || it.name.contains("compileDesktop") }
    .configureEach { dependsOn(generateDesktopVersion) }

compose.desktop {
    application {
        mainClass = "com.quickgerrit.app.MainKt"
        // Runtime override for run / packaged app
        jvmArgs += listOf(
            "-Dquickgerrit.version=$versionNameProp",
            "-Dquickgerrit.versionCode=$versionCodeProp",
            "-Dquickgerrit.githubRepo=$githubRepoProp"
        )
        nativeDistributions {
            packageName = "QuickGerrit"
            packageVersion = versionNameProp.takeIf {
                it.matches(Regex("""\d+\.\d+\.\d+"""))
            } ?: "1.0.0"
            // ...
        }
    }
}
